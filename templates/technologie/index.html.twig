{% extends 'base.html.twig' %}

{% block title %}Technologies{% endblock %}

{% block body %}

<section class="liste-tech">

    <p class="sur-titre">COMPOSANTS</p>
    <h1>Symfony dans ce projet</h1>

    <p class="intro">
        Chaque entrée est une entité Doctrine chargée par les fixtures.
        Le titre mène à une fiche avec explications et extraits de code
        du dépôt. Le bouton déplie le texte long ; le comportement repose
        sur Stimulus (<code>data-controller="archive"</code>).
    </p>

    <div data-controller="archive">

        {% for technologie in technologies %}

            <article>
                <h2>
                    <a href="{{ path('app_technologie', {slug: technologie.slug}) }}">
                        {{ technologie.nom }}
                    </a>
                </h2>

                <p class="resume">{{ technologie.description }}</p>

                <button
                    type="button"
                    data-action="click->archive#toggle"
                >
                    Afficher / masquer le détail
                </button>

                <div class="cache detail-court">
                    {% for paragraphe in technologie.contenu|split("\n\n") %}
                        {% if paragraphe|trim %}
                            <p>{{ paragraphe }}</p>
                        {% endif %}
                    {% endfor %}
                </div>
            </article>

        {% else %}
            <p class="vide">
                Aucune donnée. Exécutez
                <code>php bin/console doctrine:fixtures:load --no-interaction</code>.
            </p>
        {% endfor %}

    </div>

</section>

{% endblock %}
