{% extends 'base.html.twig' %}

{% block title %}{{ technologie.nom }} — Découverte Symfony{% endblock %}

{% block body %}

<article class="fiche-tech">

    <p class="sur-titre">FICHE</p>
    <h1>{{ technologie.nom }}</h1>

    <p class="chapeau">{{ technologie.description }}</p>

    <div class="corps">
        {% for paragraphe in technologie.contenu|split("\n\n") %}
            {% if paragraphe|trim %}
                <p>{{ paragraphe }}</p>
            {% endif %}
        {% endfor %}
    </div>

    {% include 'technologie/_exemples/' ~ technologie.slug ~ '.html.twig' ignore missing %}

    <p class="retour">
        <a href="{{ path('app_technologies') }}">← Retour à la liste</a>
    </p>

</article>

{% endblock %}
