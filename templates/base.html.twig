<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Découverte Symfony{% endblock %}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #111;
            color: #e8e8e8;
            font-family: Arial, sans-serif;
        }

        nav {
            padding: 20px 8%;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: #aaa;
            text-decoration: none;
            margin-left: 25px;
        }

        nav a:hover {
            color: white;
        }

        .logo {
            color: #fff;
            font-weight: bold;
        }

        main {
            max-width: 1100px;
            margin: auto;
            padding: 80px 30px;
        }

        h1 {
            font-size: 64px;
            max-width: 800px;
            margin: 20px 0;
        }

        p {
            color: #aaa;
            font-size: 18px;
            line-height: 1.7;
            max-width: 700px;
        }

        footer {
            border-top: 1px solid #333;
            padding: 30px 8%;
            color: #666;
        }
    </style>
</head>

<body>

<nav>
    <div class="logo">/ symfony-demo</div>

    <div>
        <a href="{{ path('app_home') }}">Accueil</a>
        <a href="{{ path('app_histoire') }}">Parcours</a>
        <a href="{{ path('app_technologies') }}">Technologies</a>
        <a href="{{ path('app_message') }}">Message</a>
    </div>
</nav>

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    Site pédagogique — Symfony 8, code dans le dépôt.
    {% if app.debug %}
        <span class="footer-dev">En dev : toolbar Symfony en bas de page.</span>
    {% endif %}
</footer>
{{ importmap('app') }}
</body>
</html>
